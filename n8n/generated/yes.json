    {
      "parameters": {
        "jsCode": "const resultado = $(\"Obtener Resultados\").first().json;\nconst presupuestos = $(\"Obtener presupuesto\").all().map(item => item.json);\n\n// Buscar el presupuesto de la misma categoría\nconst presupuesto = presupuestos.find(p => p.category_id === resultado.category_id);\n\n// 👇 Si no existe, dejamos null o 0 (elige lo que prefieras)\nconst presupuestoValor = presupuesto ? Number(presupuesto.amount) : null;\n\n// Gasto acumulado\nconst totalGastos = Number(resultado.total) || 0;\n\n// ---- Calcular % del mes ----\nconst fechaReferencia = new Date(resultado.month);\nconst anio = fechaReferencia.getFullYear();\nconst mes = fechaReferencia.getMonth();\nconst finMes = new Date(anio, mes + 1, 0);\nconst diasMes = finMes.getDate();\n\nconst hoy = new Date();\nlet diaActual;\n\nif (\n  hoy.getFullYear() === anio &&\n  hoy.getMonth() === mes\n) {\n  diaActual = hoy.getDate();\n} else {\n  diaActual = diasMes;\n}\n\nconst porcentajeMes = (diaActual / diasMes) * 100;\n\n// ---- % de gasto ----\n// 👇 Solo se calcula si hay presupuesto\nconst porcentajeGasto = presupuestoValor\n  ? (totalGastos / presupuestoValor) * 100\n  : null;\n\n// ---- diferencia ----\nconst diferencia = porcentajeGasto !== null\n  ? porcentajeGasto - porcentajeMes\n  : null;\n\n// ---- estado ----\n// 👇 Si no hay presupuesto, puedes definir estado especial\nlet estadoReal = null;\n\nif (diferencia !== null) {\n  if (diferencia < -10) {\n    estadoReal = 0;\n  } else if (diferencia <= 10) {\n    estadoReal = 1;\n  } else {\n    estadoReal = 2;\n  }\n}\n\n// ---- OUTPUT ----\nreturn [\n  {\n    json: {\n      user_id: resultado.user_id,\n      month: resultado.month,\n      category_id: resultado.category_id,\n      direction: resultado.direction,\n      presupuesto: presupuestoValor, // puede ser null\n      totalGastos,\n      porcentajeMes: Number(porcentajeMes.toFixed(2)),\n      porcentajeGasto: porcentajeGasto !== null\n        ? Number(porcentajeGasto.toFixed(2))\n        : null,\n      diferencia: diferencia !== null\n        ? Number(diferencia.toFixed(2))\n        : null,\n      estadoReal // puede ser null\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
