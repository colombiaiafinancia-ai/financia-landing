        "jsCode": "// Obtener arrays de items\nconst presupuestoItems = $items(\"Confirmation transacciones gastos\");\nconst transaccionesItems = $items(\"Confirmation transacciones ingresos\");\n\n// Verificar si el primer item del presupuesto tiene un id\nconst tienegasto =\n  presupuestoItems.length > 0 &&\n  presupuestoItems[0].json &&\n  Object.keys(presupuestoItems[0].json).length > 0 &&\n  !!presupuestoItems[0].json.id;\n\n// Verificar si el primer item de transacciones tiene un id\nconst tieneingreso =\n  transaccionesItems.length > 0 &&\n  transaccionesItems[0].json &&\n  Object.keys(transaccionesItems[0].json).length > 0 &&\n  !!transaccionesItems[0].json.id;\n\n\nreturn {\n  tienegasto,\n  tieneingreso\n};\n"
      },
